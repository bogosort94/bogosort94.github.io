---
// 爆炸星形的静态缩小版 —— 用作 header logo，呼应首页的 p5 图案
interface Props { size?: number; }
const { size = 30 } = Astro.props;
---

<svg
  class="starmark"
  width={size}
  height={size}
  viewBox="-100 -100 200 200"
  fill="none"
  aria-hidden="true"
>
  <!-- 不规则凹多边形：4 个长尖刺（上左·右·下·左下）+ 中间锯齿 -->
  <path
    d="M -8,-90 L 4,-30 L 30,-26 L 12,-10 L 92,8 L 16,12 L 26,40 L 6,18
       L 10,88 L -8,22 L -34,34 L -14,8 L -90,-6 L -20,-12 L -28,-40 L -6,-18 Z"
    stroke="currentColor"
    stroke-width="3"
    stroke-linejoin="round"
  />
</svg>

<style>
  .starmark {
    color: var(--ink);
    transition: transform 0.4s ease, color 0.2s ease;
  }
  a:hover .starmark {
    color: var(--accent);
    transform: rotate(45deg);
  }
</style>

---
import Base from '../layouts/Base.astro';

// Now 页 —— 每 1-2 个月更新一次，双语同步维护
const updated = '2026-06-22';
const items = [
  { zh: '在西雅图旅行，准备落基山脉行程。', en: 'Traveling in Seattle, planning a trip to the Rockies.' },
  { zh: '搭建自动化动量交易系统（vectorbt + Alpaca）。', en: 'Building an automated momentum trading system.' },
  { zh: '系统性学习 agentic engineering。', en: 'Learning agentic engineering, systematically.' },
  { zh: '准备九月回国，规划创业方向。', en: 'Moving back to China in September; figuring out what to build.' },
];
---

<Base title="Now · 田博雨">
  <section class="wrap page">
    <span class="eyebrow">Now</span>
    <h1>此刻</h1>
    <p class="meta">最近更新 {updated}</p>
    <ul>
      {items.map((it) => (
        <li>
          <span class="zh">{it.zh}</span>
          <span class="en">{it.en}</span>
        </li>
      ))}
    </ul>
    <p class="note">
      这是一个 <a href="https://nownownow.com" target="_blank" rel="noopener">now page</a>。
    </p>
  </section>
</Base>

<style>
  .page { max-width: 40rem; padding-block: 4rem; }
  .page h1 { font-size: clamp(2rem, 5vw, 2.75rem); margin-top: 0.4rem; }
  .meta { color: var(--ink-faint); font-size: 0.85rem; margin-top: 0.5rem; }
  ul { list-style: none; margin-top: 2.5rem; }
  li { padding-block: 0.9rem; border-bottom: 1px solid var(--line); }
  .zh { display: block; }
  .en { display: block; font-size: 0.85rem; color: var(--ink-faint); font-style: italic; margin-top: 0.2rem; }
  .note { margin-top: 2.5rem; color: var(--ink-soft); font-size: 0.9rem; }
  .note a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
</style>

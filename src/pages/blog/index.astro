---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Base title="Blog · 田博雨">
  <section class="wrap page">
    <span class="eyebrow">Blog</span>
    <h1>文字</h1>

    {posts.length === 0 ? (
      <p class="empty">还没有发布的文章。</p>
    ) : (
      <ul class="list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`}>
              <time>{fmt(post.data.date)}</time>
              <span class="title">{post.data.title}</span>
              <span class="tags">{post.data.tags.join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .page { padding-block: 4rem; }
  .page h1 { font-size: clamp(2rem, 5vw, 2.75rem); margin-top: 0.4rem; }
  .empty { margin-top: 2rem; color: var(--ink-faint); }
  .list { list-style: none; margin-top: 2.5rem; }
  .list li { border-bottom: 1px solid var(--line); }
  .list a {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.1rem;
  }
  .list time { color: var(--ink-faint); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  .list .title { font-family: var(--serif); font-size: 1.25rem; }
  .list .tags { color: var(--ink-faint); font-size: 0.8rem; }
  @media (max-width: 640px) {
    .list a { grid-template-columns: 1fr; gap: 0.25rem; }
    .list .tags { display: none; }
  }
</style>

---
import '../styles/global.css';
import StarMark from '../components/StarMark.astro';

interface Props {
  title?: string;
  description?: string;
  /** 首页不显示顶栏（爆炸图案是主角） */
  bareHeader?: boolean;
  /** 页面语言，影响 <html lang>（英文版文章传 'en'） */
  lang?: string;
}

const {
  title = '田博雨 · Boyu Tian',
  description = '不问前路，随心而动。',
  bareHeader = false,
  lang = 'zh',
} = Astro.props;

const nav = [
  { href: '/now',      en: 'Now',      zh: '此刻' },
  { href: '/blog',     en: 'Blog',     zh: '文字' },
  { href: '/projects', en: 'Projects', zh: '在做' },
  { href: '/photos',   en: 'Photos',   zh: '照片' },
  { href: '/about',    en: 'About',    zh: '关于' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- 字体：ZCOOL XiaoWei + Playfair Display（衬线标题）+ Inter（无衬线正文） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=ZCOOL+XiaoWei&family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {!bareHeader && (
      <header class="site-header wrap">
        <a href="/" class="brand" aria-label="首页">
          <StarMark size={24} />
          <span class="brand-name">田博雨 <span class="sep">·</span> <span class="en">Boyu Tian</span></span>
        </a>
        <nav>
          {nav.map((item) => (
            <a href={item.href}>
              <span class="nav-zh">{item.zh}</span>
              <span class="nav-en">{item.en}</span>
            </a>
          ))}
        </nav>
      </header>
    )}

    <main>
      <slot />
    </main>

    <footer class="site-footer wrap">
      <span>© {new Date().getFullYear()} Boyu Tian</span>
      <nav class="footer-icons">
        <a href="mailto:tian.boyu94@gmail.com" aria-label="Email">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2m0 4-8 5-8-5V6l8 5 8-5v2Z"/>
          </svg>
        </a>
        <a href="https://github.com/bogosort94" target="_blank" rel="noopener" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85 0 1.71.11 2.51.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/>
          </svg>
        </a>
        <button class="wechat-trigger" type="button" aria-label="微信二维码">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M8.69 4C4.99 4 2 6.46 2 9.5c0 1.74.99 3.29 2.55 4.31L4 16l2.27-1.14c.76.21 1.57.33 2.42.33.2 0 .39-.01.58-.02-.13-.42-.2-.86-.2-1.32 0-2.76 2.69-5 6-5 .2 0 .39.01.58.03C15.37 5.7 12.31 4 8.69 4M6.5 8a1 1 0 1 1 0 2 1 1 0 0 1 0-2m4.38 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2M15.07 10c-2.78 0-5.07 1.94-5.07 4.34 0 2.4 2.29 4.34 5.07 4.34.67 0 1.32-.1 1.91-.29L18.9 19l-.42-1.44c1.23-.78 2.02-1.96 2.02-3.29 0-2.4-2.29-4.27-5.43-4.27m-1.83 2.5a.85.85 0 1 1 0 1.7.85.85 0 0 1 0-1.7m3.66 0a.85.85 0 1 1 0 1.7.85.85 0 0 1 0-1.7Z"/>
          </svg>
        </button>
      </nav>
      <span class="eyebrow">不问前路，随心而动</span>
    </footer>

    <!-- 微信二维码弹层 -->
    <div class="qr-modal" role="dialog" aria-modal="true" aria-label="微信二维码" hidden>
      <div class="qr-backdrop" data-close></div>
      <div class="qr-panel">
        <button class="qr-close" type="button" aria-label="关闭" data-close>×</button>
        <img src="/images/wechat-qr.jpg" alt="微信二维码" width="280" height="280" />
        <p>微信扫一扫</p>
      </div>
    </div>

    <style>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 1.75rem;
        border-bottom: 1px solid var(--line);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        transition: color 0.2s ease;
      }
      .brand:hover { color: var(--accent); }
      .brand:hover :global(.starmark) { color: var(--accent); transform: rotate(45deg); }
      .brand-name {
        font-family: var(--serif);
        font-size: 1.35rem;
        letter-spacing: 0.02em;
      }
      .brand-name .sep { margin-inline: 0.15em; opacity: 0.4; }
      .brand-name .en {
        font-style: italic;
        font-size: 0.92em;
        opacity: 0.7;
      }
      .site-header nav {
        display: flex;
        gap: 1.75rem;
        font-size: 0.9rem;
      }
      .site-header nav a {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.02rem;
      }
      .nav-zh {
        font-family: var(--serif);
        font-size: 0.92rem;
        letter-spacing: 0.06em;
        position: relative;
        padding-bottom: 3px;
      }
      .nav-zh::after {
        content: '';
        position: absolute;
        left: 0; bottom: 0;
        width: 0; height: 1px;
        background: var(--accent);
        transition: width 0.25s ease;
      }
      .site-header nav a:hover .nav-zh::after { width: 100%; }
      .nav-en {
        font-family: var(--sans);
        font-size: 0.68rem;
        color: var(--ink-faint);
        font-style: italic;
      }
      main { min-height: 60vh; }
      .site-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 3rem;
        margin-top: 5rem;
        border-top: 1px solid var(--line);
        color: var(--ink-faint);
        font-size: 0.85rem;
      }
      .footer-icons {
        display: flex;
        gap: 1.25rem;
      }
      .footer-icons a,
      .footer-icons button {
        color: var(--ink-faint);
        transition: color 0.2s ease, transform 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .footer-icons a:hover,
      .footer-icons button:hover { color: var(--accent); transform: scale(1.15); }
      .footer-icons button { background: none; border: none; cursor: pointer; padding: 0; }

      /* 微信二维码弹层 */
      .qr-modal {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }
      .qr-modal[hidden] { display: none; }
      .qr-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(2px);
        opacity: 1;
        transition: opacity 0.2s ease;
      }
      .qr-modal.is-closing .qr-backdrop { opacity: 0; }
      .qr-panel {
        position: relative;
        background: var(--bg, #fff);
        padding: 1.75rem 1.75rem 1.4rem;
        border-radius: 8px;
        text-align: center;
        transform: scale(1);
        transition: transform 0.2s ease, opacity 0.2s ease;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
        max-width: calc(100vw - 3rem);
      }
      .qr-modal.is-closing .qr-panel { transform: scale(0.95); opacity: 0; }
      .qr-panel img {
        width: 280px;
        max-width: 70vw;
        height: auto;
        border-radius: 4px;
        display: block;
      }
      .qr-panel p {
        margin: 0.9rem 0 0;
        font-size: 0.85rem;
        color: var(--ink-soft);
      }
      .qr-close {
        position: absolute;
        top: 0.3rem;
        right: 0.55rem;
        background: none;
        border: none;
        font-size: 1.6rem;
        line-height: 1;
        cursor: pointer;
        color: var(--ink-faint);
        padding: 0.2rem;
        transition: color 0.2s ease;
      }
      .qr-close:hover { color: var(--ink); }

      @media (max-width: 640px) {
        .site-header { flex-direction: column; gap: 1rem; align-items: flex-start; }
        .site-header nav { gap: 1.25rem; flex-wrap: wrap; }
      }
    </style>

    <script>
      // 微信二维码弹层
      const modal = document.querySelector<HTMLElement>('.qr-modal');
      const trigger = document.querySelector<HTMLElement>('.wechat-trigger');
      if (modal && trigger) {
        function openModal() {
          modal.hidden = false;
          modal.classList.remove('is-closing');
        }
        function closeModal() {
          modal.classList.add('is-closing');
          modal.addEventListener('transitionend', () => {
            if (modal.classList.contains('is-closing')) modal.hidden = true;
          }, { once: true });
        }
        trigger.addEventListener('click', openModal);
        modal.querySelectorAll('[data-close]').forEach((el) => {
          el.addEventListener('click', closeModal);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !modal.hidden) closeModal();
        });
      }
    </script>
  </body>
</html>
